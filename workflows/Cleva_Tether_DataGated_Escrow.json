        "pythonCode": "# Extract JSON data from the Webhook\npayload = _input.item.json\n\n# Parse variables with defaults\ntransit_hours = float(payload.get('transit_hours', 0))\ntemperature = float(payload.get('temperature', 0))\nhumidity = float(payload.get('humidity', 0))\n\n# Decision rules extracted from Decision Tree model:\n# High risk if temp > 30°C and humidity > 75%, OR if transit > 48h and temp > 28°C\nis_high_risk = (temperature > 30.0 and humidity > 75.0) or (transit_hours > 48.0 and temperature > 28.0)\n\nexecute_payment = not is_high_risk\n\nreturn {\n    \"shipment_id\": payload.get('shipment_id', 'UNKNOWN'),\n    \"amount_usdt\": payload.get('amount_usdt', 0),\n    \"recipient_account\": payload.get('recipient_account', ''),\n    \"recipient_name\": payload.get('recipient_name', 'Farmer/Vendor'),\n    \"execute_payment\": execute_payment,\n    \"risk_score\": 1 if is_high_risk else 0,\n    \"status_message\": \"Telemetry verified. Cargo healthy.\" if execute_payment else \"High spoilage risk detected. Escrow locked.\"\n}"
      },
